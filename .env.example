# Environment variables for AI Agent Test
# Copy this to a file named .env and fill values you need. Do NOT commit .env to git.

# LLM provider API key (optional)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium

# Optional third-party APIs
FIRECRAWL_API_KEY=
OPENWEATHER_API_KEY=

# Enable dangerous operations (pip installs, shell commands, code execution).
# Set to 1 only when you understand the security risks.
ALLOW_DANGEROUS_TOOLS=0
